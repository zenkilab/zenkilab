  M620 S1A   ; switch material if AMS exist
  M1002 gcode_claim_action : 4
  M1002 set_filament_type:UNKNOWN
  M400
  T1
  M400
  M628 S0
  M629
  M400
  M1002 set_filament_type:PETG
