; nozzle_diameter = 0.4
; nozzle_flush_dataset = 0
; nozzle_height = 4.2
; nozzle_temperature = 250,250
; nozzle_temperature_initial_layer = 245,245
; nozzle_temperature_range_high = 270,270
; nozzle_temperature_range_low = 230,230
; nozzle_volume = 110
; nozzle_volume_type = Standard
